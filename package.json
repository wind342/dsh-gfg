{
  "name": "dsh-gfg",
  "version": "0.1.0",
  "description": "Queryable generation-fact graphs for DeepSeek Harness tool executions",
  "repository": {"type": "git", "url": "https://github.com/wind342/dsh-gfg.git"},
  "keywords": ["dsh-plugin", "deepseek-harness", "gfg", "provenance"],
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}},
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/plugin/index.js",
  "types": "dist/plugin/index.d.ts",
  "exports": {
    ".": "./dist/plugin/index.js",
    "./runtime": "./dist/runtime/graph.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "prepack": "pnpm build",
    "test": "tsx --test tests/*.test.ts",
    "test:report": "tsx --test --test-reporter=junit --test-reporter-destination=artifacts/TEST_RESULTS.xml tests/*.test.ts",
    "demo": "tsx examples/demo.ts",
    "verify": "tsx examples/verify-artifacts.ts",
    "benchmark": "tsx examples/benchmark.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "canonicalize": "2.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
